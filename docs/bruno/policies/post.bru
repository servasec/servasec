meta {
  name: post
  type: http
}

post {
  url: {{base_url}}{{api_prefix}}/policies
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "name": "Critical Slack Alert",
    "description": "Send Slack notification on critical findings",
    "scopeType": "global",
    "eventTypes": ["finding.created", "finding.updated"],
    "actions": "{\"type\":\"webhook\",\"url\":\"https://hooks.slack.com/...\"}",
    "conditions": "{\"severity\":\"critical\"}",
    "priority": 1
  }
}
