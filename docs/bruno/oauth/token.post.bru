meta {
  name: token.post
  type: http
}

post {
  url: {{base_url}}/oauth/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: authorization_code
  client_id: {{client_id}}
  code: {{authorization_code}}
  code_verifier: {{code_verifier}}
  redirect_uri: {{redirect_uri}}
}
