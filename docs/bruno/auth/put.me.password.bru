meta {
  name: put.me.password
  type: http
}

put {
  url: {{base_url}}{{api_prefix}}/me/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "currentPassword": "{{admin_password}}",
    "newPassword": "NewPass1234!"
  }
}
