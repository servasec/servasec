meta {
  name: post.register
  type: http
}

post {
  url: {{base_url}}{{api_prefix}}/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-Token: {{csrf_token}}
}

body:json {
  {
    "username": "newuser",
    "email": "newuser@example.com",
    "password": "StrongPass1!"
  }
}
