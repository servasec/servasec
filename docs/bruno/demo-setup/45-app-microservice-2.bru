  X-CSRF-Token: {{csrf_token}}
}
body:json {
  {
    "name": "Microservice 2 {{run_id}}",
    "slug": "microservice-2-{{run_id}}",
    "description": "Microservice 2 instance",
    "groupId": {{engineering_group_id}},
    "repositoryUrl": "https://github.com/servasec/microservice-2-{{run_id}}",
    "assetCriticality": "high"
  }
}
script:post-response {
  bru.setVar("microservice_2_app_id", res.body.id);
}
